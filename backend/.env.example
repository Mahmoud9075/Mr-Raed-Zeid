# Local SQLite and uploads paths are resolved automatically inside backend/.
# Set DATABASE_URL/UPLOAD_DIR only when you intentionally want custom paths.
ENV=development
JWT_SECRET=
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_OTP_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
