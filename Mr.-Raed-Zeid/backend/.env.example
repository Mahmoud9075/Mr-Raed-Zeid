ENV=development
DATABASE_URL=sqlite:///./raed.db
JWT_SECRET=replace_with_a_long_random_secret_before_production
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_before_production
ADMIN_OTP_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
